{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironoath.local/contract/proto/army.schema.json",
  "title": "ArmyProtocol",
  "description": "军队协议契约（B05 §二：训练队列、医院、兵种阶级）。由 tools/config-gen 生成 Java record 与 TS interface，禁止手改生成物。",
  "x-java-package": "com.ironoath.web.dto.generated",
  "x-ts-module": "ArmyProtocol",
  "$defs": {
    "UnitType": {
      "type": "string",
      "description": "兵种类型。取值必须与 unit 表的 type 列一致。",
      "enum": [
        "INFANTRY",
        "CAVALRY",
        "ARCHER",
        "SIEGE"
      ]
    },
    "ResourceAmount": {
      "type": "object",
      "description": "资源数量条目。与 city/bag 协议里的同名结构逐字一致 —— 三处漂移由 CI 的生成物 diff 暴露。用数组而不是 Map 是为了让客户端能保持配置表顺序展示。",
      "additionalProperties": false,
      "required": [
        "type",
        "amount"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/ResourceType"
        },
        "amount": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        }
      }
    },
    "ResourceType": {
      "type": "string",
      "description": "资源类型枚举。取值必须与 contract/config/resource.json 的 rows[].id 完全一致（CI 校验）。",
      "x-enum-source": {
        "table": "resource"
      },
      "enum": [
        "WOOD",
        "STONE",
        "IRON",
        "GRAIN",
        "GOLD",
        "STAMINA"
      ]
    },
    "UnitView": {
      "type": "object",
      "description": "一个兵种的完整视图：现有兵力、伤兵、训练中、是否已解锁。未解锁的也要下发（带 unlockHint），否则玩家看不到「再升 3 级兵营就能训 T3」这条最重要的养成牵引。",
      "additionalProperties": false,
      "required": [
        "unitId",
        "name",
        "type",
        "tier",
        "count",
        "wounded",
        "training",
        "unlocked",
        "trainTimeSec",
        "trainCost"
      ],
      "properties": {
        "unitId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/UnitType"
        },
        "tier": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "现有可用兵力（不含训练中、不含伤兵）"
        },
        "wounded": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "该兵种在医院的伤兵数"
        },
        "training": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "该兵种训练中的数量；0 表示没有在训"
        },
        "finishAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "description": "训练完成时刻；未在训练时为 null"
        },
        "remainingSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "训练剩余秒数。<b>客户端本地每秒递减，不要轮询服务端</b>（B03 §4 的同一口径）"
        },
        "unlocked": {
          "type": "boolean",
          "description": "该阶级是否已解锁（由 unit 表的 unlockBuilding + unlockBuildingLevel 与城建状态共同决定）"
        },
        "unlockHint": {
          "type": [
            "string",
            "null"
          ],
          "description": "未解锁时的结构化提示，如「需要兵营 10 级，当前 6 级」。已解锁时为 null"
        },
        "trainTimeSec": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "description": "单个兵的训练秒数，来自 unit 表。下发给客户端是为了让「训 1000 个要多久」这个预估不必客户端自己乘"
        },
        "trainCost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceAmount"
          },
          "description": "单个兵的训练消耗"
        }
      }
    },
    "HospitalView": {
      "type": "object",
      "description": "医院状态。capacity 为 0 时所有伤兵都会因超容量直接死亡（B05 §1.5），客户端必须据此显示红色警告。",
      "additionalProperties": false,
      "required": [
        "capacity",
        "used",
        "treating",
        "treatRemainingSeconds",
        "treatSecondsPerWounded",
        "treatCostRatio"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "treating": {
          "type": "boolean"
        },
        "treatFinishAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "treatRemainingSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "treatSecondsPerWounded": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "每个伤兵的治疗秒数。下发是为了让客户端能预估「治好这些要多久」而不必自己读配置"
        },
        "treatCostRatio": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "治疗消耗占训练消耗的比例（定点 ×10000）"
        }
      }
    },
    "AutoTrainView": {
      "type": "object",
      "description": "自动续训 / 自动补兵的策略视图（B25 裁决③(a)）。它是一个**有预算的策略**，不是一个布尔开关：玩家关掉游戏去睡觉时，它能自动排的批数是有上限的，用尽即停并把 stopReason 留给玩家读 —— 而不是悄悄把攒下的资源花光。",
      "additionalProperties": false,
      "required": [
        "enabled",
        "unitId",
        "batchCount",
        "batchBudget",
        "targetCount"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "玩家是否开着它"
        },
        "unitId": {
          "type": "string",
          "description": "续训 / 补回哪个兵种"
        },
        "batchCount": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "description": "每批训多少"
        },
        "batchBudget": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "还允许自动排几批。**这是预算本身，不是已排数**；0 表示已用尽"
        },
        "targetCount": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "补兵模式的目标兵力（把该兵种补回这个数）；0 = 续训模式（不设目标，每批 batchCount，排到预算用尽）"
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "停下来时的原因（玩家可读，如「预算用完了」「资源不够」）；正在跑或在等队列时为 null"
        }
      }
    },
    "AutoTrainReq": {
      "type": "object",
      "description": "POST /army/autoTrain 请求体。开启（enabled=true）时必须给全 unitId / count / batchBudget；关闭只需要 requestId 与 enabled=false —— 关闭时不必再报一遍目标，否则玩家会以为关不掉。",
      "additionalProperties": false,
      "required": [
        "requestId",
        "enabled"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "unitId": {
          "type": [
            "string",
            "null"
          ],
          "description": "续训哪个兵种；enabled=true 时必填"
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 1,
          "description": "每批数量；enabled=true 时必填"
        },
        "batchBudget": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "minimum": 1,
          "description": "最多自动排几批；enabled=true 时必填，上限见 global.json 的 AUTO_TRAIN_MAX_BATCHES"
        },
        "targetCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 1,
          "description": "补兵模式的目标兵力；传 null / 不传 = 续训模式（不设目标）"
        }
      }
    },
    "AutoTrainResp": {
      "type": "object",
      "description": "POST /army/autoTrain 响应体：落库后的策略本身，客户端照它重画开关与停止原因。",
      "additionalProperties": false,
      "required": [
        "autoTrain",
        "serverNow"
      ],
      "properties": {
        "autoTrain": {
          "$ref": "#/$defs/AutoTrainView"
        },
        "serverNow": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ArmyListResp": {
      "type": "object",
      "description": "GET /army/list 响应体。这个「读」接口有副作用：它会顺带收割到点的训练与治疗（惰性结算，服务端不跑定时器），并在自动续训/补兵开着时排下一批（同样真扣资源、真占队列）。",
      "additionalProperties": false,
      "required": [
        "units",
        "troopCap",
        "troopsInUse",
        "trainingInUse",
        "queueSlots",
        "queueSlotsMax",
        "hospital",
        "autoTrain",
        "serverNow"
      ],
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitView"
          },
          "description": "全部 20 个兵种（4 类型 × 5 阶级），含未解锁的"
        },
        "troopCap": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "带兵上限 = Σ上阵武将统帅值 × TROOP_PER_COMMAND + 科技加成（B05 §二、B06 验收 8）"
        },
        "troopsInUse": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "trainingInUse": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "训练中已占用的兵力。<b>它计入上限</b>，否则玩家可以先塞满队列再换低统率武将来绕过上限"
        },
        "queueSlots": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "queueSlotsMax": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "hospital": {
          "$ref": "#/$defs/HospitalView"
        },
        "autoTrain": {
          "$ref": "#/$defs/AutoTrainView",
          "description": "自动续训 / 补兵的当前策略。**必须在列表里下发**：这个开关的效果（排了下一批）恰好也发生在列表这个读上，玩家要能一眼看出刚才那批是自动排的、还剩几批预算、为什么停了"
        },
        "serverNow": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "TrainReq": {
      "type": "object",
      "description": "POST /army/train 请求体。时间 = 单位时间 × count（B05 §二），批量不等于加速。",
      "additionalProperties": false,
      "required": [
        "requestId",
        "unitId",
        "count"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "unitId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "TrainResp": {
      "type": "object",
      "description": "POST /army/train 响应体。cost 是本次实际扣掉的资源（= 单个消耗 × count），客户端据此播扣减动画。",
      "additionalProperties": false,
      "required": [
        "unitId",
        "count",
        "finishAt",
        "remainingSeconds",
        "reducedSeconds",
        "cost",
        "troopsInUse",
        "troopCap",
        "serverNow"
      ],
      "properties": {
        "unitId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "finishAt": {
          "type": "integer",
          "format": "int64"
        },
        "remainingSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "reducedSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "本次加速实际提前的秒数（会被剩余时间截断，不会出现负数）。开始训练时恒为 0。<b>必须单独下发</b>：客户端要据此播「-1小时」的飘字，而用 remainingSeconds 的前后差反推会受时钟抖动影响；/item/use 的契约也要求回「实际提前了多少」。"
        },
        "cost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceAmount"
          }
        },
        "troopsInUse": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "troopCap": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "serverNow": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ArmyUnitReq": {
      "type": "object",
      "description": "只带 unitId 的请求（取消训练、加速某一批训练）。",
      "additionalProperties": false,
      "required": [
        "requestId",
        "unitId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "unitId": {
          "type": "string"
        },
        "seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 0,
          "description": "加速秒数；加速请求必填"
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ],
          "description": "用加速道具时填道具 id，否则为 null"
        }
      }
    },
    "ArmyTreatSpeedUpReq": {
      "type": "object",
      "description": "POST /army/treatSpeedUp 请求体（B09/B05 的加速治疗）。\n\n**为什么不像训练那样带 unitId**（2026-09-22 改）：治疗是**全局一批**（`HospitalView` 只有 treating 与剩余秒，`TreatReq` 也只带 requestId），服务端实现里 `req.unitId()` **一次都没读** —— 而旧契约把它列成必填，于是客户端要么编一个没有意义的 unitId，要么根本发不出这个请求（这正是它一直没人调用的原因）。契约不该要求一个没人用的字段。",
      "additionalProperties": false,
      "required": [
        "requestId",
        "itemId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "itemId": {
          "type": "string",
          "description": "加速道具的 id。**必填**：服务端原话是\"加速治疗必须指定 itemId\"、\"秒数只能来自道具配置\" —— 治疗没有金币加速这条路。"
        }
      }
    },
    "TrainCancelResp": {
      "type": "object",
      "description": "POST /army/cancel 响应体。refund 是返还的资源（与城建取消同一口径：按比例返还，比例来自配置）。",
      "additionalProperties": false,
      "required": [
        "unitId",
        "count",
        "refund",
        "serverNow"
      ],
      "properties": {
        "unitId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "refund": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceAmount"
          }
        },
        "serverNow": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "TreatReq": {
      "type": "object",
      "description": "POST /army/treat 请求体。一次治疗全部伤兵（B05 §二没有「按兵种分次治疗」，那会让医院队列变成第二个训练队列）。",
      "additionalProperties": false,
      "required": [
        "requestId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        }
      }
    },
    "TreatResp": {
      "type": "object",
      "description": "开始治疗 / 加速治疗 / 收割治疗的共用响应。returned 只在收割时非空。",
      "additionalProperties": false,
      "required": [
        "woundedCount",
        "treating",
        "treatRemainingSeconds",
        "cost",
        "returned",
        "serverNow"
      ],
      "properties": {
        "woundedCount": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "treating": {
          "type": "boolean"
        },
        "treatFinishAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "treatRemainingSeconds": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "cost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceAmount"
          },
          "description": "开始治疗时是实际扣掉的资源；收割/查询时为空"
        },
        "returned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitReturned"
          },
          "description": "本次归队的伤兵"
        },
        "serverNow": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "UnitReturned": {
      "type": "object",
      "description": "归队的某个兵种数量。",
      "additionalProperties": false,
      "required": [
        "unitId",
        "count"
      ],
      "properties": {
        "unitId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        }
      }
    }
  }
}
