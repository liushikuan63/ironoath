    "note": "已下载登记、尚未接入运行时的通用素材库（2026-09-16 增补，见 CC开发全流程.md 阶段 8）。本节的路径均相对 art-src/（与 assets / derived 同一基准；sources[].local 是仓库根相对）。取用规则与 assets 相同：先复制到 client 侧、过体积与署名检查，再进 ArtCatalog —— 下载轮不预先把它们塞进包体。",
    "kenneyPacks": {
      "ui-pack": {
        "local": "kenney/ui-pack",
        "use": "通用 UI 元素：面板/按钮/进度条/复选框/滑块/页签，5 套配色 + Extra（含 Font/ 与 Sounds/，本项目用系统字体且小游戏构建已裁音频模块，取用前先看引擎裁剪清单）"
      },
      "ui-pack-rpg-expansion": {
        "local": "kenney/ui-pack-rpg-expansion",
        "use": "RPG 风 UI：面板/按钮/进度条，暗色系，最贴近本项目铜金暗红调性"
      },
      "fantasy-ui-borders": {
        "local": "kenney/fantasy-ui-borders",
        "use": "奇幻边框：单层/双层装饰边框，面板描边候选"
      },
      "game-icons": {
        "local": "kenney/game-icons",
        "use": "通用图标 105 个：黑/白两套着色 + 1x/2x PNG + Vector + Spritesheet"
      },
      "board-game-icons": {
        "local": "kenney/board-game-icons",
        "use": "桌面游戏图标：棋子/骰子/城堡/王冠等中世纪主题（PNG Default 64px / Double 128px / Tilesheet）"
      },
      "generic-items": {
        "local": "kenney/generic-items",
        "use": "通用道具图：武器/防具/药水/材料（Colored + White + Spritesheet）"
      }
    },
