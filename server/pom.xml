<?xml version="1.0" encoding="UTF-8"?>
<!--
  职责：服务端 parent POM —— 统一 Java 17、Spring Boot 3.x 版本管理与构建插件配置。
  依赖：无（顶层）。
  分层约束（B00）：game-common 不依赖任何本项目模块；game-config/game-core/game-battle 只能依赖 game-common；
                   game-common/game-core/game-battle 必须零框架依赖，由 scripts/check-layering.sh 在 CI 强制。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ironoath</groupId>
  <artifactId>ironoath-server</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>PROJECT_IRON_OATH server</name>
  <description>《列王纪·铁誓》服务端多模块工程</description>

  <modules>
    <module>game-common</module>
    <module>game-config</module>
    <module>game-core</module>
    <module>game-battle</module>
    <module>game-web</module>
    <module>tools/config-gen</module>
    <module>tools/balance-sim</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.2.5</spring-boot.version>
    <jackson.version>2.15.4</jackson.version>
    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>
    <redisson.version>3.27.2</redisson.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <exec-maven-plugin.version>3.2.0</exec-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM：仅用于版本对齐，纯 Java 模块不会引入其中任何依赖 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 本项目模块 -->
      <dependency>
        <groupId>com.ironoath</groupId>
        <artifactId>game-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ironoath</groupId>
        <artifactId>game-config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ironoath</groupId>
        <artifactId>game-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ironoath</groupId>
        <artifactId>game-battle</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 纯 Java 模块唯一允许的第三方库：JSON 解析（非框架） -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>

      <!-- Redisson：分布式锁与延迟队列（B00 陷阱 1、3）。只允许 game-web 依赖 -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>

      <!-- 纯 Java 模块的测试栈：只有 JUnit + AssertJ，绝不含 spring-boot-starter-test -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 全模块共享的测试栈（scope=test，不污染纯 Java 模块的运行期依赖） -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-parameters</arg>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- 纯 Java 层单测必须毫秒级跑完；这里显式关闭 Spring 相关的自动探测 -->
            <trimStackTrace>false</trimStackTrace>
            <!-- 铁律 10 要求中文日志。Windows 控制台默认 GBK，不强制 UTF-8 会输出乱码 -->
            <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
